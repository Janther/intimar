---
import { Image } from 'astro:assets';
import type { BlogEntry } from '../lib/data';
import { formatBlogDate } from '../lib/data';
import { withBase } from '../lib/site';

interface Props {
  post: BlogEntry;
}

const { post } = Astro.props;
const { title, pubDate, cover } = post.data;
---

<a
  href={withBase(`/blog/${post.id}`)}
  class="group flex flex-col overflow-hidden rounded-2xl border border-ink-200 bg-surface shadow-sm transition hover:-translate-y-1 hover:shadow-md"
>
  <div class="aspect-video overflow-hidden">
    {
      cover ? (
        <Image
          src={cover}
          alt={title}
          loading="lazy"
          width={480}
          height={270}
          class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
        />
      ) : (
        // No cover set — a plain wash in brand tones rather than a
        // fabricated stock photo, so the grid stays visually consistent
        // until a real image is added to the post's frontmatter.
        <div
          class="h-full w-full"
          style="background: linear-gradient(135deg, var(--color-terracotta-200), var(--color-ink-200));"
        />
      )
    }
  </div>

  <div class="flex flex-1 flex-col p-6">
    <h3 class="font-serif text-lg text-ink-900">{title}</h3>
    <p class="mt-2 flex flex-1 items-center gap-1.5 text-xs text-ink-muted">
      <span class="pi pi-calendar" aria-hidden="true"></span>
      {formatBlogDate(pubDate)}
    </p>
  </div>
</a>
