---
import { Image } from 'astro:assets';
import type { BlogEntry } from '../lib/data';
import { resolveBlogAuthor, formatShortDate } from '../lib/data';
import { withBase } from '../lib/site';
import Tag from './vue/Tag.vue';

interface Props {
  post: BlogEntry;
}

const { post } = Astro.props;
const { title, summary, pubDate, tags } = post.data;
const author = await resolveBlogAuthor(post);
---

<a
  href={withBase(`/blog/${post.id}`)}
  class="group flex flex-col rounded-2xl border border-ink-200 bg-surface p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-md"
>
  <p class="text-xs text-ink-muted">{formatShortDate(pubDate)}</p>
  <h3 class="mt-2 font-serif text-lg text-ink-900">{title}</h3>
  <p class="mt-2 line-clamp-3 flex-1 text-sm text-ink-700">{summary}</p>

  <div class="mt-4 flex items-center gap-2">
    {
      author.photo && (
        <Image
          src={author.photo}
          alt={author.name}
          loading="lazy"
          class="h-7 w-7 rounded-full object-cover"
        />
      )
    }
    <span class="text-sm text-ink-muted">{author.name}</span>
  </div>

  {
    tags.length > 0 && (
      <div class="mt-3 flex flex-wrap gap-1.5">
        {tags.slice(0, 3).map((tag) => (
          <Tag>{tag}</Tag>
        ))}
      </div>
    )
  }
</a>
