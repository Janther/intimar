---
import {
  formatDateRange,
  formatPrice,
  formatShortDate,
  isEarlyBirdActive,
  type EventEntry,
} from '../lib/data';

interface Props {
  event: EventEntry;
}

const { event } = Astro.props;
const {
  title,
  summary,
  location,
  startDate,
  endDate,
  earlyBirdPrice,
  earlyBirdDeadline,
  price,
  currency,
  image,
  tags,
} = event.data;
const earlyBird = isEarlyBirdActive(earlyBirdDeadline);
---

<a
  href={`/events/${event.id}`}
  class="group flex flex-col overflow-hidden rounded-2xl border border-brand-200 bg-white shadow-sm transition hover:-translate-y-1 hover:shadow-md"
>
  <div class="aspect-[4/3] overflow-hidden">
    <img
      src={image}
      alt={title}
      loading="lazy"
      class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
    />
  </div>
  <div class="flex flex-1 flex-col gap-2 p-5">
    <div class="flex flex-wrap gap-1.5">
      {
        tags
          .slice(0, 3)
          .map((tag) => (
            <span class="rounded-full bg-brand-100 px-2.5 py-0.5 text-xs text-brand-700">
              {tag}
            </span>
          ))
      }
    </div>
    <h3 class="font-serif text-lg text-brand-900">{title}</h3>
    <p class="line-clamp-2 text-sm text-brand-700">{summary}</p>
    <div
      class="mt-auto flex items-center justify-between pt-3 text-sm text-brand-600"
    >
      <span>{location}</span>
      {
        earlyBird ? (
          <span class="flex items-baseline gap-1.5">
            <span class="font-medium text-brand-900">
              {formatPrice(earlyBirdPrice, currency)}
            </span>
            <span class="text-xs text-brand-400 line-through">
              {formatPrice(price, currency)}
            </span>
          </span>
        ) : (
          <span class="font-medium text-brand-900">
            {formatPrice(price, currency)}
          </span>
        )
      }
    </div>
    {
      earlyBird && (
        <p class="text-xs font-medium text-accent-gold">
          Early bird ends {formatShortDate(earlyBirdDeadline)}
        </p>
      )
    }
    <p class="text-xs text-brand-500">{formatDateRange(startDate, endDate)}</p>
  </div>
</a>
