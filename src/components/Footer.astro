---
import { CONTACT_EMAIL } from '../lib/site';

const year = new Date().getFullYear();
---

<footer class="border-t border-brand-200/60 bg-brand-100/40">
  <div class="mx-auto grid max-w-6xl gap-8 px-6 py-12 md:grid-cols-3">
    <div>
      <p class="font-serif text-lg text-brand-900">Intimar</p>
      <p class="mt-2 max-w-xs text-sm text-brand-700">
        Small, in-person tantra retreats led by a select team of guides, rooted
        in breath, presence, and conscious touch.
      </p>
    </div>

    <div>
      <p class="text-sm font-semibold text-brand-900">Explore</p>
      <ul class="mt-3 space-y-2 text-sm text-brand-700">
        <li>
          <a href="/events" class="hover:text-brand-900">Upcoming retreats</a>
        </li>
        <li><a href="/team" class="hover:text-brand-900">Our guides</a></li>
        <li><a href="/about" class="hover:text-brand-900">About Intimar</a></li>
      </ul>
    </div>

    <div>
      <p class="text-sm font-semibold text-brand-900">Get in touch</p>
      <ul class="mt-3 space-y-2 text-sm text-brand-700">
        <li><a href="/contact" class="hover:text-brand-900">Contact us</a></li>
        <li>
          <a href={`mailto:${CONTACT_EMAIL}`} class="hover:text-brand-900"
            >{CONTACT_EMAIL}</a
          >
        </li>
      </ul>
    </div>
  </div>

  <div
    class="border-t border-brand-200/60 px-6 py-4 text-center text-xs text-brand-600"
  >
    © {year} Intimar. All rights reserved.
  </div>
</footer>
