---
import { CONTACT_EMAIL, withBase } from '../lib/site';

const year = new Date().getFullYear();
---

<footer class="border-t border-brand-200/60 bg-brand-100/40">
  <div class="mx-auto grid max-w-6xl gap-8 px-6 py-12 md:grid-cols-3">
    <div>
      <p class="font-serif text-lg text-brand-900">Intimar</p>
      <p class="mt-2 max-w-xs text-sm text-brand-700">
        Retiros de tantra pequeños y presenciales, guiados por un equipo
        selecto, con raíces en la respiración, la presencia y el contacto
        consciente.
      </p>
    </div>

    <div>
      <p class="text-sm font-semibold text-brand-900">Explorar</p>
      <ul class="mt-3 space-y-2 text-sm text-brand-700">
        <li>
          <a href={withBase('/events')} class="hover:text-brand-900"
            >Próximos retiros</a
          >
        </li>
        <li>
          <a href={withBase('/team')} class="hover:text-brand-900"
            >Nuestros facilitadores</a
          >
        </li>
        <li>
          <a href={withBase('/about')} class="hover:text-brand-900"
            >Sobre Intimar</a
          >
        </li>
      </ul>
    </div>

    <div>
      <p class="text-sm font-semibold text-brand-900">Contáctanos</p>
      <ul class="mt-3 space-y-2 text-sm text-brand-700">
        <li>
          <a href={withBase('/contact')} class="hover:text-brand-900"
            >Escríbenos</a
          >
        </li>
        <li>
          <a href={`mailto:${CONTACT_EMAIL}`} class="hover:text-brand-900"
            >{CONTACT_EMAIL}</a
          >
        </li>
      </ul>
    </div>
  </div>

  <div
    class="border-t border-brand-200/60 px-6 py-4 text-center text-xs text-brand-600"
  >
    © {year} Intimar. Todos los derechos reservados.
  </div>
</footer>
