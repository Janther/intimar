---
const navLinks = [
  { href: '/events', label: 'Retiros' },
  { href: '/team', label: 'Facilitadores' },
  { href: '/about', label: 'Nosotros' },
  { href: '/contact', label: 'Contacto' },
];
---

<header
  class="sticky top-0 z-40 border-b border-brand-200/60 bg-brand-50/90 backdrop-blur"
>
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
    <a href="/" class="font-serif text-xl tracking-wide text-brand-900"
      >Intimar</a
    >

    <nav class="hidden items-center gap-8 md:flex">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="text-sm text-brand-700 transition hover:text-brand-900"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <a
      href="/events"
      class="hidden rounded-full bg-brand-700 px-5 py-2 text-sm font-medium text-brand-50 transition hover:bg-brand-800 md:inline-block"
    >
      Ver Retiros
    </a>

    <details class="relative md:hidden">
      <summary
        class="list-none rounded-md p-2 text-brand-800 [&::-webkit-details-marker]:hidden"
      >
        <span class="pi pi-bars text-xl" aria-hidden="true"></span>
        <span class="sr-only">Abrir menú</span>
      </summary>
      <nav
        class="absolute right-0 mt-2 flex w-48 flex-col gap-1 rounded-lg border border-brand-200 bg-brand-50 p-3 shadow-lg"
      >
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class="rounded px-3 py-2 text-sm text-brand-700 hover:bg-brand-100"
            >
              {link.label}
            </a>
          ))
        }
      </nav>
    </details>
  </div>
</header>
