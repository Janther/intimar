---
import { Image } from 'astro:assets';
import type { TeamEntry } from '../lib/data';

interface Props {
  member: TeamEntry;
}

const { member } = Astro.props;
const { name, role, photo, specialties } = member.data;
---

<a
  href={`/team/${member.id}`}
  class="group flex flex-col items-center rounded-2xl border border-brand-200 bg-surface p-6 text-center shadow-sm transition hover:-translate-y-1 hover:shadow-md"
>
  <Image
    src={photo}
    alt={name}
    loading="lazy"
    class="h-28 w-28 rounded-full object-cover ring-4 ring-brand-100 transition group-hover:ring-brand-200"
  />
  <h3 class="mt-4 font-serif text-lg text-brand-900">{name}</h3>
  <p class="text-sm text-brand-600">{role}</p>
  <div class="mt-3 flex flex-wrap justify-center gap-1.5">
    {
      specialties
        .slice(0, 3)
        .map((specialty) => (
          <span class="rounded-full bg-brand-100 px-2.5 py-0.5 text-xs text-brand-700">
            {specialty}
          </span>
        ))
    }
  </div>
</a>
