---
import { Image } from 'astro:assets';
import type { TeamEntry } from '../lib/data';
import { withBase } from '../lib/site';
import Tag from './vue/Tag.vue';

interface Props {
  member: TeamEntry;
}

const { member } = Astro.props;
const { name, role, photo, specialties } = member.data;
---

<a
  href={withBase(`/team#${member.id}`)}
  class="group flex flex-col items-center rounded-2xl border border-ink-200 bg-surface p-6 text-center shadow-sm transition hover:-translate-y-1 hover:shadow-md"
>
  <div class="relative shrink-0">
    <Image
      src={photo}
      alt={name}
      loading="lazy"
      width={224}
      height={224}
      class="h-28 w-28 rounded-[32%_68%_49%_51%/62%_40%_60%_38%] object-cover ring-4 ring-ink-100 transition group-hover:ring-ink-200"
    />
    <div
      aria-hidden="true"
      class="pointer-events-none absolute -inset-1 rounded-[68%_32%_51%_49%/40%_62%_38%_60%] border-2 border-ink-400/70"
    ></div>
  </div>
  <h3 class="mt-4 font-serif text-lg text-ink-900">{name}</h3>
  <p class="text-sm text-ink-600">{role}</p>
  <div class="mt-3 flex flex-wrap justify-center gap-1.5">
    {specialties.slice(0, 3).map((specialty) => (
      <Tag>{specialty}</Tag>
    ))}
  </div>
</a>
