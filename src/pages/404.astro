---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Página no encontrada"
  description="La página que buscas no existe o fue movida."
>
  <section
    class="mx-auto flex max-w-2xl flex-col items-center px-6 py-28 text-center"
  >
    <p class="text-sm font-medium tracking-widest text-brand-500 uppercase">
      404
    </p>
    <h1 class="mt-2 font-serif text-3xl text-brand-900 sm:text-4xl">
      Esta página no existe
    </h1>
    <p class="mt-4 max-w-md text-brand-700">
      Puede que el enlace esté roto o que la página haya sido movida. Prueba con
      uno de estos caminos.
    </p>
    <div class="mt-9 flex flex-wrap justify-center gap-4">
      <a
        href="/events"
        class="rounded-full bg-brand-700 px-7 py-3.5 text-sm font-medium text-brand-50 transition hover:bg-brand-600"
      >
        Ver Próximos Retiros
      </a>
      <a
        href="/team"
        class="rounded-full border border-brand-200 px-7 py-3.5 text-sm font-medium text-brand-900 transition hover:bg-brand-100"
      >
        Conoce a tus Facilitadores
      </a>
    </div>
  </section>
</Layout>
