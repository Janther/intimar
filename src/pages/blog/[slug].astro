---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Tag from '../../components/vue/Tag.vue';
import BlogCard from '../../components/BlogCard.astro';
import ShareButtons from '../../components/vue/ShareButtons.vue';
import {
  getAllBlogPosts,
  getAdjacentBlogPosts,
  resolveBlogAuthor,
  formatShortDate,
} from '../../lib/data';
import { withBase } from '../../lib/site';

export async function getStaticPaths() {
  const posts = await getAllBlogPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { title, summary, pubDate, tags, cover } = post.data;
const { Content } = await render(post);
const author = await resolveBlogAuthor(post);
const { previous, next } = await getAdjacentBlogPosts(post);

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: summary,
  image: cover ? new URL(cover.src, Astro.site).toString() : undefined,
  datePublished: pubDate.toISOString(),
  // No separate "updated" tracking exists yet in the content schema, so
  // this is currently always the same instant as datePublished.
  dateModified: pubDate.toISOString(),
  author: {
    '@type': 'Person',
    name: author.name,
    url: author.href ? new URL(author.href, Astro.site).toString() : undefined,
  },
  publisher: {
    '@type': 'Organization',
    name: 'Intimar',
    url: Astro.site?.toString(),
    // No logo asset exists yet — add one here once the brand mark ships;
    // Google's Article rich-result eligibility wants publisher.logo.
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalURL },
  url: canonicalURL,
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Inicio',
      item: Astro.site?.toString(),
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Blog',
      item: new URL(withBase('/blog'), Astro.site).toString(),
    },
    { '@type': 'ListItem', position: 3, name: title, item: canonicalURL },
  ],
};
---

<Layout
  title={title}
  description={summary}
  image={cover?.src}
  imageAlt={title}
  imageWidth={cover?.width}
  imageHeight={cover?.height}
  structuredData={[articleSchema, breadcrumbSchema]}
  ogType="article"
  articlePublishedTime={pubDate.toISOString()}
  articleAuthor={author.name}
>
  <article class="mx-auto max-w-4xl px-6 py-16">
    <a
      href={withBase('/blog')}
      class="text-sm text-ink-muted hover:text-ink-900">← Blog</a
    >

    <p class="mt-6 text-sm text-ink-muted">{formatShortDate(pubDate)}</p>
    <h1 class="mt-2 font-serif text-3xl text-ink-900 sm:text-4xl">
      {title}
    </h1>

    <div class="mt-4 flex items-center gap-3">
      {
        author.photo && (
          <Image
            src={author.photo}
            alt={author.name}
            class="h-10 w-10 rounded-full object-cover"
          />
        )
      }
      <div>
        {
          author.href ? (
            <a
              href={author.href}
              class="text-sm font-medium text-ink-800 hover:text-ink-900"
            >
              {author.name}
            </a>
          ) : (
            <p class="text-sm font-medium text-ink-800">{author.name}</p>
          )
        }
        {author.bio && <p class="text-sm text-ink-muted">{author.bio}</p>}
      </div>
    </div>

    <div class="mt-4">
      <ShareButtons title={title} url={canonicalURL} client:load />
    </div>

    {
      tags.length > 0 && (
        <div class="mt-4 flex flex-wrap gap-1.5">
          {tags.map((tag) => (
            <Tag>{tag}</Tag>
          ))}
        </div>
      )
    }

    {
      cover && (
        <Image
          src={cover}
          alt={title}
          loading="eager"
          fetchpriority="high"
          class="mt-8 w-full rounded-2xl object-cover"
        />
      )
    }

    <div class="prose mt-8 max-w-none blog-content">
      <Content />
    </div>

    {
      (previous || next) && (
        <nav
          class="mt-16 border-t border-ink-200 pt-8"
          aria-labelledby="continue-reading-heading"
        >
          <h2
            id="continue-reading-heading"
            class="font-serif text-xl text-ink-900"
          >
            Continúa leyendo
          </h2>
          <div class="mt-6 grid grid-cols-1 gap-6 sm:grid-cols-2">
            {previous && <BlogCard post={previous} />}
            {next && <BlogCard post={next} />}
          </div>
        </nav>
      )
    }
  </article>
</Layout>
