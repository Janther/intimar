---
import Layout from '../../layouts/Layout.astro';
import BlogCard from '../../components/BlogCard.astro';
import { getAllBlogPosts } from '../../lib/data';
import { withBase } from '../../lib/site';

const posts = await getAllBlogPosts();

const blogSchema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Intimar — Blog',
  url: new URL(withBase('/blog'), Astro.site).toString(),
  blogPost: posts.map((post) => ({
    '@type': 'BlogPosting',
    headline: post.data.title,
    datePublished: post.data.pubDate.toISOString(),
    url: new URL(withBase(`/blog/${post.id}`), Astro.site).toString(),
  })),
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Inicio',
      item: Astro.site?.toString(),
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Blog',
      item: new URL(withBase('/blog'), Astro.site).toString(),
    },
  ],
};
---

<Layout
  title="Blog"
  description="Reflexiones sobre tantra, respiración y contacto consciente desde el equipo de Intimar."
  structuredData={[blogSchema, breadcrumbSchema]}
>
  <section class="mx-auto max-w-6xl px-6 py-16">
    <p
      class="text-sm font-medium tracking-widest text-terracotta-text uppercase"
    >
      Blog
    </p>
    <h1 class="mt-2 font-serif text-3xl text-ink-900 sm:text-4xl">
      Reflexiones desde el equipo
    </h1>
    <p class="mt-4 max-w-2xl text-ink-700">
      Notas sobre práctica, respiración y contacto consciente — escritas por
      quienes guían nuestros retiros, y a veces por quienes los observan desde
      afuera.
    </p>

    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map((post) => <BlogCard post={post} />)}
    </div>
  </section>
</Layout>
