---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import InterestDialog from '../../components/vue/InterestDialog.vue';
import {
  getAllEvents,
  getEventHosts,
  formatDateRange,
  formatPrice,
  formatShortDate,
  isEarlyBirdActive,
} from '../../lib/data';
import { withBase } from '../../lib/site';
import Tag from '../../components/vue/Tag.vue';

export async function getStaticPaths() {
  const events = await getAllEvents();
  return events.map((event) => ({
    params: { id: event.id },
    props: { event },
  }));
}

const { event } = Astro.props;
const {
  title,
  description,
  location,
  startDate,
  endDate,
  earlyBirdPrice,
  earlyBirdDeadline,
  price,
  currency,
  image,
  tags,
} = event.data;
const hosts = await getEventHosts(event);
const earlyBird = isEarlyBirdActive(earlyBirdDeadline);
const savings = price - earlyBirdPrice;

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
const eventSchema = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: title,
  description: event.data.summary,
  startDate: startDate.toISOString(),
  endDate: endDate.toISOString(),
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  eventStatus: 'https://schema.org/EventScheduled',
  location: {
    '@type': 'Place',
    name: location,
  },
  image: [new URL(image.src, Astro.site).toString()],
  offers: {
    '@type': 'Offer',
    url: canonicalURL,
    price,
    priceCurrency: currency,
    availability: 'https://schema.org/InStock',
  },
  organizer: {
    '@type': 'Organization',
    name: 'Intimar',
    url: Astro.site?.toString(),
  },
  performer: hosts.map((host) => ({
    '@type': 'Person',
    name: host.data.name,
  })),
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Inicio',
      item: Astro.site?.toString(),
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Retiros',
      item: new URL(withBase('/events'), Astro.site).toString(),
    },
    { '@type': 'ListItem', position: 3, name: title, item: canonicalURL },
  ],
};
---

<Layout
  title={title}
  description={event.data.summary}
  image={image.src}
  imageAlt={title}
  imageWidth={image.width}
  imageHeight={image.height}
  structuredData={[eventSchema, breadcrumbSchema]}
>
  <article class="mx-auto max-w-4xl px-6 py-16">
    <a
      href={withBase('/events')}
      class="text-sm text-ink-600 hover:text-ink-900">← Todos los retiros</a
    >

    <div class="mt-4 flex flex-wrap gap-1.5">
      {tags.map((tag) => <Tag>{tag}</Tag>)}
    </div>

    <h1 class="mt-3 font-serif text-3xl text-ink-900 sm:text-4xl">{title}</h1>
    <p class="mt-2 text-ink-600">
      {location} · {formatDateRange(startDate, endDate)}
    </p>

    <Image
      src={image}
      alt={title}
      class="mt-8 aspect-[16/9] w-full rounded-2xl object-cover"
    />

    <div class="mt-10 grid gap-10 sm:grid-cols-[2fr_1fr]">
      <div class="prose max-w-none prose-p:text-ink-700">
        <p class="text-ink-700">{description}</p>

        {
          hosts.length > 0 && (
            <div class="mt-8">
              <h2 class="font-serif text-xl text-ink-900">Guiado por</h2>
              <div class="mt-4 flex flex-wrap gap-4">
                {hosts.map((host) => (
                  <a
                    href={withBase(`/team/${host.id}`)}
                    class="flex items-center gap-3 rounded-xl border border-ink-200 bg-surface p-3 pr-5 transition hover:shadow-sm"
                  >
                    <Image
                      src={host.data.photo}
                      alt={host.data.name}
                      class="h-12 w-12 rounded-full object-cover"
                    />
                    <div>
                      <p class="text-sm font-medium text-ink-900">
                        {host.data.name}
                      </p>
                      <p class="text-xs text-ink-600">{host.data.role}</p>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          )
        }
      </div>

      <aside class="h-fit rounded-2xl border border-ink-200 bg-surface p-6">
        {
          earlyBird ? (
            <>
              <div class="flex items-baseline gap-2">
                <p class="text-2xl font-medium text-ink-900">
                  {formatPrice(earlyBirdPrice, currency)}
                </p>
                <p class="text-sm text-ink-600 line-through">
                  {formatPrice(price, currency)}
                </p>
              </div>
              <p class="text-sm text-ink-600">por persona, early bird</p>
              <div class="mt-3 rounded-lg bg-ink-100 px-3 py-2 text-xs font-medium text-ink-700">
                Ahorra {formatPrice(savings, currency)} — inscríbete antes del{' '}
                {formatShortDate(earlyBirdDeadline)}
              </div>
            </>
          ) : (
            <>
              <p class="text-2xl font-medium text-ink-900">
                {formatPrice(price, currency)}
              </p>
              <p class="text-sm text-ink-600">por persona</p>
            </>
          )
        }
        <dl class="mt-4 space-y-2 text-sm text-ink-700">
          <div class="flex justify-between">
            <dt>Fechas</dt>
            <dd>{formatDateRange(startDate, endDate)}</dd>
          </div>
          <div class="flex justify-between">
            <dt>Ubicación</dt>
            <dd>{location}</dd>
          </div>
        </dl>
        <div class="mt-6">
          <InterestDialog eventTitle={title} client:load />
        </div>
      </aside>
    </div>
  </article>
</Layout>
