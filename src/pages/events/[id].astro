---
import Layout from '../../layouts/Layout.astro';
import InterestDialog from '../../components/vue/InterestDialog.vue';
import {
  getAllEvents,
  getEventHosts,
  formatDateRange,
  formatPrice,
  formatShortDate,
  isEarlyBirdActive,
} from '../../lib/data';

export async function getStaticPaths() {
  const events = await getAllEvents();
  return events.map((event) => ({
    params: { id: event.id },
    props: { event },
  }));
}

const { event } = Astro.props;
const {
  title,
  description,
  location,
  startDate,
  endDate,
  earlyBirdPrice,
  earlyBirdDeadline,
  price,
  currency,
  image,
  tags,
} = event.data;
const hosts = await getEventHosts(event);
const earlyBird = isEarlyBirdActive(earlyBirdDeadline);
const savings = price - earlyBirdPrice;
---

<Layout title={title} description={event.data.summary}>
  <article class="mx-auto max-w-4xl px-6 py-16">
    <a href="/events" class="text-sm text-brand-600 hover:text-brand-900"
      >← All retreats</a
    >

    <div class="mt-4 flex flex-wrap gap-1.5">
      {
        tags.map((tag) => (
          <span class="rounded-full bg-brand-100 px-2.5 py-0.5 text-xs text-brand-700">
            {tag}
          </span>
        ))
      }
    </div>

    <h1 class="mt-3 font-serif text-3xl text-brand-900 sm:text-4xl">{title}</h1>
    <p class="mt-2 text-brand-600">
      {location} · {formatDateRange(startDate, endDate)}
    </p>

    <img
      src={image}
      alt={title}
      class="mt-8 aspect-[16/9] w-full rounded-2xl object-cover"
    />

    <div class="mt-10 grid gap-10 sm:grid-cols-[2fr_1fr]">
      <div class="prose prose-p:text-brand-700 max-w-none">
        <p class="text-brand-700">{description}</p>

        {
          hosts.length > 0 && (
            <div class="mt-8">
              <h2 class="font-serif text-xl text-brand-900">Hosted by</h2>
              <div class="mt-4 flex flex-wrap gap-4">
                {hosts.map((host) => (
                  <a
                    href={`/team/${host.id}`}
                    class="flex items-center gap-3 rounded-xl border border-brand-200 bg-white p-3 pr-5 transition hover:shadow-sm"
                  >
                    <img
                      src={host.data.photo}
                      alt={host.data.name}
                      class="h-12 w-12 rounded-full object-cover"
                    />
                    <div>
                      <p class="text-sm font-medium text-brand-900">
                        {host.data.name}
                      </p>
                      <p class="text-xs text-brand-600">{host.data.role}</p>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          )
        }
      </div>

      <aside class="h-fit rounded-2xl border border-brand-200 bg-white p-6">
        {
          earlyBird ? (
            <>
              <div class="flex items-baseline gap-2">
                <p class="text-2xl font-medium text-brand-900">
                  {formatPrice(earlyBirdPrice, currency)}
                </p>
                <p class="text-sm text-brand-400 line-through">
                  {formatPrice(price, currency)}
                </p>
              </div>
              <p class="text-sm text-brand-600">per person, early bird</p>
              <div class="mt-3 rounded-lg bg-brand-100 px-3 py-2 text-xs font-medium text-brand-700">
                Save {formatPrice(savings, currency)} — register by{' '}
                {formatShortDate(earlyBirdDeadline)}
              </div>
            </>
          ) : (
            <>
              <p class="text-2xl font-medium text-brand-900">
                {formatPrice(price, currency)}
              </p>
              <p class="text-sm text-brand-600">per person</p>
            </>
          )
        }
        <dl class="mt-4 space-y-2 text-sm text-brand-700">
          <div class="flex justify-between">
            <dt>Dates</dt>
            <dd>{formatDateRange(startDate, endDate)}</dd>
          </div>
          <div class="flex justify-between">
            <dt>Location</dt>
            <dd>{location}</dd>
          </div>
        </dl>
        <div class="mt-6">
          <InterestDialog eventTitle={title} client:load />
        </div>
      </aside>
    </div>
  </article>
</Layout>
