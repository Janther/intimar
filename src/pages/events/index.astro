---
import Layout from '../../layouts/Layout.astro';
import EventsExplorer from '../../components/vue/EventsExplorer.vue';
import { getAllEvents, toEventSummary } from '../../lib/data';

const eventSummaries = (await getAllEvents()).map(toEventSummary);
---

<Layout
  title="Retiros"
  description="Próximos retiros de tantra organizados por Intimar."
>
  <section class="mx-auto max-w-6xl px-6 py-16">
    <p class="text-sm font-medium tracking-widest text-brand-500 uppercase">
      Retiros
    </p>
    <h1 class="mt-2 font-serif text-3xl text-brand-900 sm:text-4xl">
      Próximos retiros
    </h1>
    <p class="mt-4 max-w-2xl text-brand-700">
      Cada retiro es guiado en persona por nuestro propio equipo. Busca por
      palabra clave o filtra por enfoque para encontrar el que más te acomode.
    </p>

    <div class="mt-10">
      <EventsExplorer events={eventSummaries} client:load />
    </div>
  </section>
</Layout>
