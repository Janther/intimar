---
import Layout from '../layouts/Layout.astro';
import EventCard from '../components/vue/EventCard.vue';
import TeamCard from '../components/TeamCard.astro';
import Testimonials from '../components/vue/Testimonials.vue';
import {
  getFeaturedEvents,
  getAllTeamMembers,
  getAllTestimonials,
  toEventSummary,
} from '../lib/data';
import { withBase } from '../lib/site';

const featuredEvents = await Promise.all(
  (await getFeaturedEvents()).slice(0, 3).map(toEventSummary),
);
const team = (await getAllTeamMembers()).slice(0, 4);
const testimonials = (await getAllTestimonials()).map(
  (testimonial) => testimonial.data,
);

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Intimar',
  url: Astro.site?.toString(),
  description:
    'Intimar guía retiros de tantra pequeños y presenciales, con raíces en la respiración, la presencia y el contacto consciente.',
};
---

<Layout title="Inicio" structuredData={organizationSchema}>
  <section class="hero-candlelit">
    <div
      class="mx-auto flex max-w-2xl flex-col items-center px-6 py-28 text-center sm:py-36"
    >
      <p
        class="text-xs font-medium tracking-[0.28em] text-accent-gold uppercase"
      >
        Retiros de Tantra y Encuentros Íntimos
      </p>
      <h1
        class="mt-7 font-serif text-5xl leading-tight text-hero-fg sm:text-6xl"
      >
        Vuelve a tu cuerpo, <em class="font-allura text-accent-gold not-italic"
          >juntos</em
        >.
      </h1>
      <p class="mx-auto mt-7 max-w-lg text-lg font-light text-hero-fg/80">
        Intimar guía retiros de tantra pequeños y presenciales, con raíces en la
        respiración, la presencia y el contacto consciente — nunca más de un par
        de decenas de personas.
      </p>
      <div class="mt-9 flex flex-wrap justify-center gap-4">
        <a
          href={withBase('/events')}
          class="rounded-full bg-terracotta-500 px-7 py-3.5 text-sm font-medium text-white transition hover:bg-terracotta-400"
        >
          Ver Próximos Retiros
        </a>
        <a
          href={withBase('/team')}
          class="rounded-full border border-hero-fg/35 px-7 py-3.5 text-sm font-medium text-hero-fg transition hover:bg-hero-fg/10"
        >
          Conoce a tus Facilitadores
        </a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-20">
    <div class="mb-8 flex items-end justify-between">
      <h2 class="font-serif text-2xl text-ink-900">Próximos retiros</h2>
      <a
        href={withBase('/events')}
        class="text-sm text-ink-700 hover:text-ink-900">Ver todos →</a
      >
    </div>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {featuredEvents.map((event) => <EventCard event={event} />)}
    </div>
  </section>

  <section class="border-y border-ink-200/60 bg-ink-100/40 py-4">
    <Testimonials testimonials={testimonials} client:visible />
  </section>

  <section class="mx-auto max-w-6xl px-6 py-20">
    <div class="mb-8 flex items-end justify-between">
      <h2 class="font-serif text-2xl text-ink-900">Nuestros facilitadores</h2>
      <a
        href={withBase('/team')}
        class="text-sm text-ink-700 hover:text-ink-900">Conócelos a todos →</a
      >
    </div>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {team.map((member) => <TeamCard member={member} />)}
    </div>
  </section>
</Layout>
