---
import Layout from '../layouts/Layout.astro';
import EventCard from '../components/EventCard.astro';
import TeamCard from '../components/TeamCard.astro';
import Testimonials from '../components/vue/Testimonials.vue';
import {
  getFeaturedEvents,
  getAllTeamMembers,
  getAllTestimonials,
} from '../lib/data';

const featuredEvents = (await getFeaturedEvents()).slice(0, 3);
const team = (await getAllTeamMembers()).slice(0, 4);
const testimonials = (await getAllTestimonials()).map(
  (testimonial) => testimonial.data,
);
---

<Layout title="Home">
  <section class="hero-candlelit">
    <div
      class="mx-auto flex max-w-2xl flex-col items-center px-6 py-28 text-center sm:py-36"
    >
      <p
        class="text-xs font-medium tracking-[0.28em] text-accent-gold uppercase"
      >
        Tantra Retreats &amp; Small Gatherings
      </p>
      <h1
        class="mt-7 font-serif text-5xl leading-tight text-brand-50 sm:text-6xl"
      >
        Come home to the body, <em class="text-accent-gold italic">together</em
        >.
      </h1>
      <p class="mx-auto mt-7 max-w-lg text-lg font-light text-brand-50/80">
        Intimar leads small, in-person tantra retreats rooted in breath,
        presence, and conscious touch — never more than a couple dozen guests at
        a time.
      </p>
      <div class="mt-9 flex flex-wrap justify-center gap-4">
        <a
          href="/events"
          class="rounded-full bg-brand-700 px-7 py-3.5 text-sm font-medium text-brand-50 transition hover:bg-brand-600"
        >
          View Upcoming Retreats
        </a>
        <a
          href="/team"
          class="rounded-full border border-brand-50/35 px-7 py-3.5 text-sm font-medium text-brand-50 transition hover:bg-brand-50/10"
        >
          Meet Your Guides
        </a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-20">
    <div class="mb-8 flex items-end justify-between">
      <h2 class="font-serif text-2xl text-brand-900">Upcoming retreats</h2>
      <a href="/events" class="text-sm text-brand-700 hover:text-brand-900"
        >See all →</a
      >
    </div>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {featuredEvents.map((event) => <EventCard event={event} />)}
    </div>
  </section>

  <section class="border-y border-brand-200/60 bg-brand-100/40 py-4">
    <Testimonials testimonials={testimonials} client:visible />
  </section>

  <section class="mx-auto max-w-6xl px-6 py-20">
    <div class="mb-8 flex items-end justify-between">
      <h2 class="font-serif text-2xl text-brand-900">Your guides</h2>
      <a href="/team" class="text-sm text-brand-700 hover:text-brand-900"
        >Meet everyone →</a
      >
    </div>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {team.map((member) => <TeamCard member={member} />)}
    </div>
  </section>
</Layout>
