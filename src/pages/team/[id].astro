---
import Layout from '../../layouts/Layout.astro';
import EventCard from '../../components/EventCard.astro';
import { getAllTeamMembers, getEventsHostedBy } from '../../lib/data';

export async function getStaticPaths() {
  const team = await getAllTeamMembers();
  return team.map((member) => ({
    params: { id: member.id },
    props: { member },
  }));
}

const { member } = Astro.props;
const { name, role, bio, photo, specialties, social } = member.data;
const hostedEvents = await getEventsHostedBy(member.id);
---

<Layout title={name} description={`${name}, ${role} en Intimar.`}>
  <article class="mx-auto max-w-4xl px-6 py-16">
    <a href="/team" class="text-sm text-brand-600 hover:text-brand-900"
      >← Nuestros facilitadores</a
    >

    <div
      class="mt-6 flex flex-col items-center gap-6 text-center sm:flex-row sm:items-start sm:text-left"
    >
      <img
        src={photo}
        alt={name}
        class="h-32 w-32 shrink-0 rounded-full object-cover ring-4 ring-brand-100"
      />
      <div>
        <h1 class="font-serif text-3xl text-brand-900">{name}</h1>
        <p class="mt-1 text-brand-600">{role}</p>
        <div
          class="mt-3 flex flex-wrap justify-center gap-1.5 sm:justify-start"
        >
          {
            specialties.map((specialty) => (
              <span class="rounded-full bg-brand-100 px-2.5 py-0.5 text-xs text-brand-700">
                {specialty}
              </span>
            ))
          }
        </div>
        <div
          class="mt-3 flex justify-center gap-4 text-sm text-brand-600 sm:justify-start"
        >
          {
            social.instagram && (
              <a href={social.instagram} class="hover:text-brand-900">
                Instagram
              </a>
            )
          }
          {
            social.website && (
              <a href={social.website} class="hover:text-brand-900">
                Sitio web
              </a>
            )
          }
        </div>
      </div>
    </div>

    <p class="mt-8 max-w-2xl text-brand-700">{bio}</p>

    {
      hostedEvents.length > 0 && (
        <div class="mt-12">
          <h2 class="font-serif text-xl text-brand-900">Retiros que guía</h2>
          <div class="mt-4 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {hostedEvents.map((event) => (
              <EventCard event={event} />
            ))}
          </div>
        </div>
      )
    }
  </article>
</Layout>
