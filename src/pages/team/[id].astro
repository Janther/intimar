---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import EventCard from '../../components/vue/EventCard.vue';
import {
  getAllTeamMembers,
  getEventsHostedBy,
  toEventSummary,
} from '../../lib/data';
import { withBase } from '../../lib/site';
import Tag from '../../components/vue/Tag.vue';

export async function getStaticPaths() {
  const team = await getAllTeamMembers();
  return team.map((member) => ({
    params: { id: member.id },
    props: { member },
  }));
}

const { member } = Astro.props;
const { name, role, bio, photo, specialties, social } = member.data;
const hostedEvents = await Promise.all(
  (await getEventsHostedBy(member.id)).map(toEventSummary),
);

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name,
  jobTitle: role,
  description: bio,
  image: new URL(photo.src, Astro.site).toString(),
  url: canonicalURL,
  worksFor: {
    '@type': 'Organization',
    name: 'Intimar',
    url: Astro.site?.toString(),
  },
  sameAs: [social.instagram, social.website].filter(Boolean),
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Inicio',
      item: Astro.site?.toString(),
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Facilitadores',
      item: new URL(withBase('/team'), Astro.site).toString(),
    },
    { '@type': 'ListItem', position: 3, name, item: canonicalURL },
  ],
};
---

<Layout
  title={name}
  description={`${name}, ${role} en Intimar.`}
  image={photo.src}
  imageAlt={name}
  imageWidth={photo.width}
  imageHeight={photo.height}
  structuredData={[personSchema, breadcrumbSchema]}
>
  <article class="mx-auto max-w-4xl px-6 py-16">
    <a href={withBase('/team')} class="text-sm text-ink-600 hover:text-ink-900"
      >← Nuestros facilitadores</a
    >

    <div
      class="mt-6 flex flex-col items-center gap-6 text-center sm:flex-row sm:items-start sm:text-left"
    >
      <Image
        src={photo}
        alt={name}
        class="h-32 w-32 shrink-0 rounded-full object-cover ring-4 ring-ink-100"
      />
      <div>
        <h1 class="font-serif text-3xl text-ink-900">{name}</h1>
        <p class="mt-1 text-ink-600">{role}</p>
        <div
          class="mt-3 flex flex-wrap justify-center gap-1.5 sm:justify-start"
        >
          {specialties.map((specialty) => <Tag>{specialty}</Tag>)}
        </div>
        <div
          class="mt-3 flex justify-center gap-3 text-ink-600 sm:justify-start"
        >
          {
            social.instagram && (
              <a
                href={social.instagram}
                target="_blank"
                rel="noopener noreferrer"
                class="transition hover:text-ink-900"
                aria-label="Instagram"
              >
                <span class="pi pi-instagram text-xl" aria-hidden="true" />
              </a>
            )
          }
          {
            social.website && (
              <a
                href={social.website}
                target="_blank"
                rel="noopener noreferrer"
                class="transition hover:text-ink-900"
                aria-label="Sitio web"
              >
                <span class="pi pi-globe text-xl" aria-hidden="true" />
              </a>
            )
          }
        </div>
      </div>
    </div>

    <p class="mt-8 max-w-2xl text-ink-700">{bio}</p>

    {
      hostedEvents.length > 0 && (
        <div class="mt-12">
          <h2 class="font-serif text-xl text-ink-900">Retiros que guía</h2>
          <div class="mt-4 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {hostedEvents.map((event) => (
              <EventCard event={event} />
            ))}
          </div>
        </div>
      )
    }
  </article>
</Layout>
