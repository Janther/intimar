---
import { getImage } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import FacilitatorSection from '../../components/FacilitatorSection.astro';
import { getAllTeamMembers } from '../../lib/data';
import { withBase } from '../../lib/site';

const team = await getAllTeamMembers();

const personSchemas = await Promise.all(
  team.map(async (member) => {
    const { name, role, photo, social } = member.data;
    // Resize before emitting — `photo.src` alone would ship the original,
    // unresized source file (up to 16MB) into the build output.
    const schemaPhoto = await getImage({ src: photo, width: 512, height: 512 });
    return {
      '@context': 'https://schema.org',
      '@type': 'Person',
      name,
      jobTitle: role,
      description: member.data.summary ?? member.body,
      image: new URL(schemaPhoto.src, Astro.site).toString(),
      url: new URL(withBase(`/team#${member.id}`), Astro.site).toString(),
      worksFor: {
        '@type': 'Organization',
        name: 'Intimar',
        url: Astro.site?.toString(),
      },
      sameAs: [social.instagram, social.website].filter(Boolean),
    };
  }),
);
---

<Layout
  title="Nuestros Facilitadores"
  description="Conoce a los profesores de tantra y facilitadores detrás de los retiros de Intimar."
  structuredData={personSchemas}
>
  <section class="mx-auto max-w-4xl px-6 py-16">
    <p class="text-sm font-medium tracking-widest text-terracotta-text uppercase">
      Nuestros Facilitadores
    </p>
    <h1 class="mt-2 font-serif text-3xl text-ink-900 sm:text-4xl">
      Las personas que guían cada retiro
    </h1>
    <p class="mt-4 max-w-2xl text-ink-700">
      Cada retiro de Intimar es guiado en persona por uno o más de nuestros
      facilitadores — nunca lo tercerizamos a profesionales externos con quienes
      no hayamos practicado nosotros mismos.
    </p>

    <div class="mt-12 flex flex-col gap-12 sm:gap-24">
      {team.map((member, index) => (
        <FacilitatorSection member={member} index={index} />
      ))}
    </div>
  </section>
</Layout>
